# Database Configuration (Local Development)
DB_NAME=businessbetter
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# Production Database (Render/Cloud)
DATABASE_URL=postgresql://user:password@host:port/database

# Flask Configuration
SECRET_KEY=your_secret_key_here_generate_with_secrets.token_hex(32)
FLASK_ENV=development

# Encryption Master Key (CRITICAL - Generate with: python utils/encryption.py)
# This key encrypts all tenant credentials (SMTP passwords, API keys, etc.)
# NEVER commit this to git! Store securely and backup safely.
ENCRYPTION_MASTER_KEY=hjnPcq6OlJF9dphiOrUS_LMVD5mIYbCKm0NJznxo0IE=

# Email Configuration (if needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password

# Stripe Configuration (if using payments)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Other Configuration
UPLOAD_FOLDER=static/uploads/logos
MAX_CONTENT_LENGTH=16777216
