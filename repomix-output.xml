<file path="templates/admin/base.html">
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Super Admin | Business Better{% endblock %}</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <style>
        /* --- GLOBAL THEME VARIABLES --- */
        :root { 
            --primary-gold: #C5A059; 
            --bg-dark: #121212; 
            --card-bg: #1f1f1f; 
            --sidebar-bg: #1f1f1f;
            --text-main: #e0e0e0;
            --text-muted: #a0a0a0;
            --border-color: #333;
            --sidebar-width: 280px;
        }
        
        body { 
            background-color: var(--bg-dark); 
            color: var(--text-main); 
            font-family: 'Inter', sans-serif; 
            margin: 0; 
        }

        h1, h2, h3, h4, h5, h6 {
            color: #ffffff !important;
            font-family: 'Montserrat', sans-serif;
        }
        
        /* --- SIDEBAR --- */
        .sidebar { 
            width: var(--sidebar-width); 
            height: 100vh; 
            position: fixed; 
            background: var(--sidebar-bg); 
            padding: 30px; 
            border-right: 1px solid var(--border-color); 
            z-index: 1000;
            overflow-y: auto;
        }

        /* FORCE SIDEBAR HEADERS TO BE VISIBLE (THE FIX) */
        .sidebar .text-muted {
            color: #b0b0b0 !important; /* Forces Light Grey text */
            opacity: 1 !important;
        }

        .brand { 
            font-family: 'Montserrat', sans-serif; 
            font-size: 1.2rem; 
            font-weight: 700;
            color: #fff; 
            margin-bottom: 40px; 
            display: flex; 
            align-items: center; 
            gap: 10px; 
            text-decoration: none;
            letter-spacing: 1px;
        }
        .brand img { width: 35px; height: auto; }
        .tagline { color: var(--primary-gold); font-weight: 400; }

        .sidebar-btn {
            display: flex; 
            align-items: center; 
            padding: 12px 15px; 
            color: #aaa; 
            text-decoration: none; 
            border-radius: 8px; 
            margin-bottom: 5px; 
            transition: 0.3s; 
            font-weight: 600;
            border: 1px solid transparent;
        }

        .sidebar-btn:hover, .sidebar-btn.active {
            background: rgba(197, 160, 89, 0.1);
            color: var(--primary-gold);
            border-color: rgba(197, 160, 89, 0.2);
        }
        
        .sidebar-btn i { width: 25px; }

        /* --- CONTENT WRAPPER --- */
        .content { 
            margin-left: var(--sidebar-width); 
            padding: 40px 50px; 
            min-height: 100vh;
        }

        /* --- SHARED COMPONENTS --- */
        .card-dark { 
            background: var(--card-bg); 
            border: 1px solid var(--border-color); 
            border-radius: 12px; 
            color: var(--text-main);
            overflow: hidden;
        }

        .btn-gold {
            background: var(--primary-gold); color: #000 !important; font-weight: 700;
            border: none; padding: 10px 25px; border-radius: 5px; transition: 0.3s; text-decoration: none;
        }
        .btn-gold:hover { background: #fff; transform: translateY(-2px); }

        /* Table Styles */
        .table-dark-custom { --bs-table-bg: transparent; --bs-table-border-color: var(--border-color); }
        .table-dark-custom th { 
            text-transform: uppercase; font-size: 0.75rem; 
            letter-spacing: 1px; padding-bottom: 15px; 
            font-family: 'Montserrat', sans-serif;
            color: var(--primary-gold);
        }
        .table-dark-custom td { 
            vertical-align: middle; color: #ffffff !important; 
            font-size: 0.95rem; padding: 15px 10px; 
        }

        /* Search Input */
        .search-input {
            background: var(--card-bg); border: 1px solid var(--border-color);
            color: white; padding: 10px 15px 10px 40px; border-radius: 8px;
            width: 100%; transition: 0.3s;
        }
        .search-input:focus { border-color: var(--primary-gold); outline: none; }
    </style>
    {% block styles %}{% endblock %}
</head>
<body>

    <div class="sidebar">
        <a href="/super-admin" class="brand">
            <img src="/static/images/logo.png" alt="DG">
            <div>DRUGAN <span class="tagline">GROUP</span></div>
        </a>
        
        <div class="d-flex flex-column gap-2">
            <small class="text-muted text-uppercase mb-2" style="font-size: 0.7rem; letter-spacing: 1px;">Admin Console</small>
            
            <a href="/super-admin" class="sidebar-btn {{ 'active' if request.path == '/super-admin' else '' }}">
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </a>
            <a href="/super-admin/analytics" class="sidebar-btn {{ 'active' if 'analytics' in request.path else '' }}">
                <i class="fas fa-chart-pie"></i> Intelligence
            </a>
            
            <a href="{{ url_for('plans.view_plans') }}" class="sidebar-btn {{ 'active' if 'plans' in request.path else '' }}">
                <i class="fas fa-tags"></i> Plans & Pricing
            </a>
            
            <small class="text-muted text-uppercase mb-2 mt-4" style="font-size: 0.7rem; letter-spacing: 1px;">Security & Logs</small>
            
            <a href="{{ url_for('admin.view_audit_logs') }}" class="sidebar-btn {{ 'active' if 'audit' in request.path else '' }}">
                <i class="fas fa-shield-alt"></i> Audit Trail
            </a>
            <a href="{{ url_for('admin.view_system_logs') }}" class="sidebar-btn {{ 'active' if 'system' in request.path else '' }}">
                <i class="fas fa-exclamation-triangle"></i> Error Logs
            </a>

            <small class="text-muted text-uppercase mb-2 mt-4" style="font-size: 0.7rem; letter-spacing: 1px;">Navigation</small>
            
            <a href="/logout" class="sidebar-btn">
                <i class="fas fa-arrow-left"></i> Logout
            </a>
            
            <div class="mt-5 pt-4 border-top border-secondary">
                <small class="text-muted text-uppercase mb-2 mt-4" style="font-size: 0.7rem; letter-spacing: 1px;">Maintenance</small>

                <a href="/admin/database-repair" class="sidebar-btn text-warning" onclick="return confirm('⚠️ Run database integrity repair?');">
                    <i class="fas fa-tools"></i> Repair DB Integrity
                </a>

                <a href="/admin/cleanup-my-data" class="sidebar-btn text-danger" onclick="return confirm('⚠️ WARNING: This will delete ALL Jobs, Staff, and Clients from YOUR account (ID 1). Continue?');">
                    <i class="fas fa-trash-alt"></i> Wipe Test Data
                </a>
                <a href="/admin/backup/all" class="sidebar-btn text-success">
                    <i class="fas fa-download"></i> Backup DB
                </a>
            </div>
        </div>
    </div>

    <div class="content">
        {% with messages = get_flashed_messages() %}
            {% if messages %}
                <div class="alert alert-dark border-secondary shadow-lg mb-4 d-flex align-items-center">
                    <i class="fas fa-info-circle me-3" style="color: var(--primary-gold);"></i> 
                    <div style="color: white;">{{ messages[0] }}</div>
                </div>
            {% endif %}
        {% endwith %}

        {% block content %}{% endblock %}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
</file>

<file path="templates/office/job_files.html">
{% extends "office/office_base.html" %}

{% block title %}Job Dashboard | {{ job.ref }}{% endblock %}

{% block content %}
<div class="container-fluid p-0">
    
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="/office-hub" class="text-decoration-none text-muted">Office</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{{ job.ref }}</li>
                </ol>
            </nav>

            <div class="d-flex align-items-center gap-3 mb-1">
                <h2 class="fw-bold m-0 text-dark">{{ job.title }}</h2>
                <span class="badge rounded-pill fs-6 fw-normal 
                    {% if job.status == 'Completed' %}bg-success{% elif job.status == 'In Progress' %}bg-primary{% else %}bg-secondary{% endif %}">
                    {{ job.status }}
                </span>
            </div>

            <div class="fs-5 text-secondary mb-2">
                {{ job.desc }}
            </div>

            <div class="text-muted small d-flex align-items-center gap-3">
                <span><i class="fas fa-user-circle me-1"></i> {{ job.client }}</span>
                <span><i class="fas fa-map-marker-alt me-1"></i> {{ job.address }}</span>
                <span><i class="fas fa-hashtag me-1"></i> {{ job.ref }}</span>
            </div>
        </div>

        <div class="btn-group shadow-sm">
    {% if quote_id %}
        <a href="/office/quote/{{ quote_id }}" class="btn btn-outline-dark fw-bold">
            <i class="fas fa-file-contract me-2"></i>Quote
        </a>
        <a href="/office/quote/{{ quote_id }}/convert" class="btn btn-outline-dark fw-bold" onclick="return confirm('Create Invoice?')">
            <i class="fas fa-file-invoice-dollar me-2"></i>Invoice
        </a>
    {% endif %}
    
    <a href="/office/job/{{ job.id }}/rams/create" class="btn btn-warning fw-bold text-dark">
        <i class="fas fa-clipboard-check me-2"></i>RAMS
    </a>

    <a href="/office/job/{{ job.id }}/files" class="btn btn-dark fw-bold">
        <i class="fas fa-sync-alt"></i>
    </a>
</div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-info">
                <div class="card-body py-3">
                    <div class="small text-muted fw-bold text-uppercase">Budget</div>
                    <div class="fs-4 fw-bold">£{{ "%.2f"|format(quote_total) }}</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
                <div class="card-body py-3">
                    <div class="small text-muted fw-bold text-uppercase">Billed</div>
                    <div class="fs-4 fw-bold text-success">£{{ "%.2f"|format(total_billed) }}</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-danger">
                <div class="card-body py-3">
                    <div class="small text-muted fw-bold text-uppercase">Costs</div>
                    <div class="fs-4 fw-bold text-danger">£{{ "%.2f"|format(total_cost) }}</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
                <div class="card-body py-3">
                    <div class="small text-muted fw-bold text-uppercase">Profit</div>
                    <div class="fs-4 fw-bold text-dark">£{{ "%.2f"|format(profit) }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-bold py-3">
                    <i class="fas fa-images me-2 text-primary"></i> Site Photos
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        {% set has_photos = false %}
                        {% for f in files if f[0] == 'Site Photo' %}
                            {% set has_photos = true %}
                            <div class="col-4 col-sm-3 col-md-2">
                                <a href="/{{ f[4] }}" target="_blank" class="d-block position-relative ratio ratio-1x1 border rounded overflow-hidden">
                                    <img src="/{{ f[4] }}" class="w-100 h-100 object-fit-cover" alt="Site Photo">
                                </a>
                            </div>
                        {% endfor %}
                        
                        {% if not has_photos %}
                            <div class="col-12 text-center py-4 text-muted bg-light rounded border border-dashed">
                                <i class="fas fa-camera fa-2x mb-2 opacity-25"></i>
                                <p class="small m-0">No photos uploaded yet.</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold py-3 d-flex justify-content-between align-items-center">
    <span><i class="fas fa-list-ul me-2 text-dark"></i> Project Timeline</span>
    
    <a href="/office/job/{{ job.id }}/material-list" class="btn btn-sm btn-outline-dark fw-bold">
        <i class="fas fa-file-pdf me-2"></i> Merchant List
    </a>
</div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="bg-light text-muted text-uppercase">
                            <tr>
                                <th class="ps-3">Type</th>
                                <th>Description</th>
                                <th>Date</th>
                                <th class="text-end">Amount</th>
                                <th class="text-end pe-3">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for f in files if f[0] != 'Site Photo' %}
                            <tr>
                                <td class="ps-3">
    {% if 'Invoice' in f[0] %}
        <span class="badge bg-success-subtle text-success">Invoice</span>
    {% elif 'RAMS' in f[0] %}  <span class="badge bg-primary text-white">RAMS / Safety</span>
    {% elif f[0] == 'Timesheet' %}
        <span class="badge bg-warning-subtle text-dark">Labor</span>
    {% elif f[0] == 'Material' %}
        <span class="badge bg-secondary-subtle text-secondary">Material</span>
    {% else %}
        <span class="badge bg-danger-subtle text-danger">Expense</span>
    {% endif %}
</td>
                                <td class="fw-bold text-dark">{{ f[1] }}</td>
                                <td class="text-muted">{{ f[3] }}</td>
                                <td class="text-end font-monospace">
                                    {% if f[2] > 0 %}£{{ "%.2f"|format(f[2]) }}{% else %}-{% endif %}
                                </td>
                                <td class="text-end pe-3">
                                    {% if 'Invoice' in f[0] %}
                                        <a href="{{ url_for('finance.download_invoice_pdf', invoice_id=f[5]) }}" target="_blank" class="btn btn-xs btn-outline-primary"><i class="fas fa-download"></i></a>
                                    {% elif f[4] != 'No Link' and f[4] != 'Material' %}
                                        <a href="/{{ f[4] }}" target="_blank" class="btn btn-xs btn-outline-secondary"><i class="fas fa-eye"></i></a>
                                    {% endif %}
                                    
                                    {% if 'Invoice' not in f[0] %}
                                        <a href="/office/job/delete-item/{{ f[5] }}/{{ f[0] }}" onclick="return confirm('Delete?')" class="btn btn-xs btn-outline-danger ms-1"><i class="fas fa-times"></i></a>
                                    {% endif %}
                                </td>
                            </tr>
                            {% else %}
                            <tr><td colspan="5" class="text-center py-3 text-muted">No activity logged.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

        <div class="col-lg-4">
            
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom-0 pt-3">
                    <ul class="nav nav-pills nav-fill small fw-bold" id="pills-tab" role="tablist">
                        <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-upload"><i class="fas fa-upload me-1"></i> Upload</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-cost"><i class="fas fa-coins me-1"></i> Cost</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-time"><i class="fas fa-clock me-1"></i> Time</button></li>
                    </ul>
                </div>
                <div class="card-body tab-content bg-light rounded-bottom">
                    
                    <div class="tab-pane fade show active" id="tab-upload">
                        <form action="/office/upload-center" method="POST" enctype="multipart/form-data">
						<input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <input type="hidden" name="job_ref" value="{{ job.ref }}">
                            <label class="small fw-bold mb-2">Upload File / Photo</label>
                            <input type="file" name="file" class="form-control form-control-sm mb-3" required>
                            <button class="btn btn-primary w-100 fw-bold btn-sm">Upload</button>
                        </form>
                    </div>

                    <div class="tab-pane fade" id="tab-cost">
                        <form action="/office/job/{{ job.ref }}/add-manual-cost" method="POST">
						<input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <label class="small fw-bold">Description</label>
                            <input type="text" name="description" class="form-control form-control-sm mb-2" required>
                            <label class="small fw-bold">Amount (£)</label>
                            <input type="number" step="0.01" name="cost" class="form-control form-control-sm mb-3" required>
                            <button class="btn btn-warning w-100 fw-bold btn-sm text-dark">Add Expense</button>
                        </form>
                    </div>

                    <div class="tab-pane fade" id="tab-time">
                        <form action="/office/job/{{ job.id }}/log-hours" method="POST">
						<input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <label class="small fw-bold">Staff</label>
                            <select name="staff_id" class="form-select form-select-sm mb-2">
                                {% for s in staff %}
                                    <option value="{{ s[0] }}">{{ s[1] }}</option>
                                {% endfor %}
                            </select>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="small fw-bold">Hours</label>
                                    <input type="number" name="hours" step="0.5" class="form-control form-control-sm">
                                </div>
                                <div class="col-6">
                                    <label class="small fw-bold">Date</label>
                                    <input type="date" name="date" class="form-control form-control-sm" value="{{ today }}">
                                </div>
                            </div>
                            <button class="btn btn-info w-100 fw-bold btn-sm text-white">Log Hours</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-bold py-3">
                    <i class="fas fa-book me-2 text-dark"></i> Site Diary
                    <span class="badge bg-secondary-subtle text-secondary ms-1">{{ diary|length }}</span>
                </div>
                <div class="card-body" style="max-height: 320px; overflow-y: auto;">
                    {% for d in diary %}
                    <div class="border-start border-3 border-dark ps-2 mb-3">
                        <div class="d-flex justify-content-between">
                            <strong class="small">{{ d[0] }}</strong>
                            <span class="text-muted" style="font-size: 0.7rem;">{{ d[2].strftime('%d/%m %H:%M') if d[2] else '' }}</span>
                        </div>
                        <div class="small text-dark">{{ d[1] }}</div>
                    </div>
                    {% else %}
                    <div class="text-center text-muted small py-3">
                        <i class="fas fa-book-open fa-2x mb-2 opacity-25 d-block"></i>
                        No notes from site workers yet.
                    </div>
                    {% endfor %}
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h6 class="fw-bold mb-3 small text-uppercase text-muted">Budget Remaining</h6>

                    {% set pct = 0 %}
                    {% if quote_total > 0 %} {% set pct = (total_cost / quote_total) * 100 %} {% endif %}
                    
                    <div class="progress" style="height: 20px;">
                        <div class="progress-bar {% if pct > 100 %}bg-danger{% elif pct > 85 %}bg-warning{% else %}bg-success{% endif %}" 
                             style="width: {{ pct }}%">{{ pct|round|int }}%</div>
                    </div>
                    <div class="d-flex justify-content-between mt-2 small fw-bold">
                        <span>Used: £{{ "%.0f"|format(total_cost) }}</span>
                        <span class="{{ 'text-danger' if budget_remaining < 0 else 'text-success' }}">
                            {{ 'Over' if budget_remaining < 0 else 'Left' }}: £{{ "%.0f"|format(budget_remaining|abs) }}
                        </span>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold small text-uppercase text-muted mb-3">Client Contact</h6>
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-light rounded-circle p-2 me-3"><i class="fas fa-user text-secondary"></i></div>
                        <div>
                            <div class="fw-bold">{{ job.client }}</div>
                            <div class="small text-muted">Client</div>
                        </div>
                    </div>
                    {% if job.email %}
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-light rounded-circle p-2 me-3"><i class="fas fa-envelope text-secondary"></i></div>
                        <a href="mailto:{{ job.email }}" class="text-decoration-none text-dark small">{{ job.email }}</a>
                    </div>
                    {% endif %}
                    {% if job.phone %}
                    <div class="d-flex align-items-center">
                        <div class="bg-light rounded-circle p-2 me-3"><i class="fas fa-phone text-secondary"></i></div>
                        <a href="tel:{{ job.phone }}" class="text-decoration-none text-dark small">{{ job.phone }}</a>
                    </div>
                    {% endif %}
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
</file>

