        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="clientTable">
                <thead class="table-light text-uppercase small">
                    <tr>
                        <th class="ps-4">Client Name</th>
                        <th>Contact Info</th>
                        <th>Status</th>
                        <th class="text-end pe-4" style="min-width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for c in clients %}
                    <tr class="client-row" style="position: relative;">
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="client-avatar">{{ c[1][0] | upper }}</div>
                                <div>
                                    <a href="/client/{{ c[0] }}" class="fw-bold text-dark text-decoration-none stretched-link client-name">
                                        {{ c[1] }}
                                    </a>
                                    <div class="small text-muted">{{ c[8] or 'No internal notes' }}</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            {% if c[2] %}<div class="small client-email"><i class="fas fa-envelope text-muted me-2" style="width:15px;"></i>{{ c[2] }}</div>{% endif %}
                            {% if c[3] %}<div class="small client-phone"><i class="fas fa-phone text-muted me-2" style="width:15px;"></i>{{ c[3] }}</div>{% endif %}
                        </td>
                        <td>
                            {{ status_badge(c[5]) }}
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group" style="position: relative; z-index: 2;">
                                
                                <button class="btn btn-sm btn-outline-dark" 
                                        title="Edit Client"
                                        type="button"
                                        onclick="openEditModal('{{ c[0] }}', '{{ c[1] }}', '{{ c[2] }}', '{{ c[3] }}', '{{ c[5] }}', '{{ c[8] or '' }}')">
                                    <i class="fas fa-edit"></i>
                                </button>
                                
                                <a href="/client/delete/{{ c[0] }}" 
                                   class="btn btn-sm btn-outline-danger" 
                                   title="Delete Client"
                                   onclick="return confirm('⚠️ Are you sure?\n\nThis will delete the client AND ALL their properties/jobs.\n\nThis cannot be undone.');">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="4" class="text-center py-5 text-muted">No clients found. Add one to get started.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="clientModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="modalTitle">Add New Client</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/clients/add" method="POST" id="clientForm">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                    <input type="hidden" name="client_id" id="client_id">
                    
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="small fw-bold">Client / Company Name</label>
                                <input type="text" name="name" id="c_name" class="form-control fw-bold" required>
                            </div>
                            <div class="col-md-4">
                                <label class="small fw-bold">Status</label>
                                <select name="status" id="c_status" class="form-select">
                                    <option value="Active">Active</option>
                                    <option value="Inactive">Inactive</option>
                                    <option value="Lead">Lead / Prospect</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="small fw-bold">Email Address</label>
                                <input type="email" name="email" id="c_email" class="form-control">
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold">Phone Number</label>
                                <input type="text" name="phone" id="c_phone" class="form-control">
                            </div>
                            
                            <div class="col-12">
                                <label class="small fw-bold">Billing Address</label>
                                <textarea name="billing_address" id="c_addr" class="form-control" rows="2"></textarea>
                            </div>
                            
                            <div class="col-12">
                                <label class="small fw-bold">Internal Notes</label>
                                <input type="text" name="notes" id="c_notes" class="form-control" placeholder="Key codes, access info, etc.">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="submit" class="btn btn-primary fw-bold" id="modalSubmitBtn">Save Client</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
<script>
    // 1. OPEN MODAL FOR NEW CLIENT
    function openAddModal() {
        // Reset the form for a fresh entry
        document.getElementById('clientForm').reset();
        document.getElementById('clientForm').action = "/clients/add";
        document.getElementById('client_id').value = "";
        
        document.getElementById('modalTitle').innerText = "Add New Client";
        document.getElementById('modalSubmitBtn').innerText = "Save Client";
        
        var myModal = new bootstrap.Modal(document.getElementById('clientModal'));
        myModal.show();
    }

    // 2. OPEN MODAL FOR EDITING (Fills the form with data)
    function openEditModal(id, name, email, phone, status, notes) {
        // Reset first
        document.getElementById('clientForm').reset();
        
        // Point form to UPDATE route
        document.getElementById('clientForm').action = "/clients/update";
        document.getElementById('client_id').value = id;
        
        // Update Title
        document.getElementById('modalTitle').innerText = "Edit Client: " + name;
        document.getElementById('modalSubmitBtn').innerText = "Update Record";

        // Inject data into inputs
        document.getElementById('c_name').value = name;
        document.getElementById('c_email').value = (email == 'None' ? '' : email);
        document.getElementById('c_phone').value = (phone == 'None' ? '' : phone);
        document.getElementById('c_status').value = status;
        document.getElementById('c_notes').value = (notes == 'None' ? '' : notes);

        // Show the shared modal
        var myModal = new bootstrap.Modal(document.getElementById('clientModal'));
        myModal.show();
    }

    // 3. SEARCH FILTER
    function filterClients() {
        var input = document.getElementById("clientSearch");
        var filter = input.value.toUpperCase();
        var table = document.getElementById("clientTable");
        var tr = table.getElementsByTagName("tr");

        for (var i = 1; i < tr.length; i++) {
            var name = tr[i].querySelector(".client-name");
            var email = tr[i].querySelector(".client-email");
            var phone = tr[i].querySelector(".client-phone");
            
            var txtValue = "";
            if (name) txtValue += name.textContent || name.innerText;
            if (email) txtValue += email.textContent || email.innerText;
            if (phone) txtValue += phone.textContent || phone.innerText;

            if (txtValue.toUpperCase().indexOf(filter) > -1) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }
</script>
{% endblock %}
</file>

