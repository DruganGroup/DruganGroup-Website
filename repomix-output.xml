        /* Step-by-Step Vertical Connector Styles */
        .process-container {
            position: relative;
            max-width: 1000px;
            margin: 0 auto;
            padding: 50px 0;
        }
        
        /* The Vertical Line */
        .process-container::before {
            content: '';
            position: absolute;
            left: 50%;
            top: 0;
            bottom: 0;
            width: 2px;
            background: linear-gradient(to bottom, transparent, var(--primary-gold), transparent);
            transform: translateX(-1px);
        }

        .process-step {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 100px;
            position: relative;
        }

        /* Alternating Layout */
        .process-step.reverse {
            flex-direction: row-reverse;
        }

        .step-content {
            width: 45%;
            background: rgba(255,255,255,0.03);
            padding: 40px;
            border-radius: 15px;
            border: 1px solid rgba(255,255,255,0.05);
            transition: 0.3s;
        }

        .step-content:hover {
            border-color: var(--primary-gold);
            transform: translateY(-5px);
