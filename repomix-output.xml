                <input type="text" name="signature" class="form-control form-control-lg mt-1" placeholder="Type Name to Sign" required>
                <div class="form-text small">By submitting, I confirm the vehicle is safe to drive.</div>
            </div>
        </div>

        <button type="submit" class="btn btn-success w-100 btn-lg fw-bold shadow mb-5 py-3">
            <i class="fas fa-check-circle me-2"></i> Submit Safety Check
        </button>

    </form>
</div>
{% endblock %}
</file>

