<file path="templates/portal/portal_job_view.html">
{% extends "portal/portal_base.html" %}

{% block title %}Job {{ job[1] }} | {{ company_name }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0">{{ job[3] or 'Job Details' }}</h2>
        <p class="text-muted mb-0">Reference: {{ job[1] }}</p>
    </div>
    <a href="/portal/home" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-2"></i>Back
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <small class="text-muted text-uppercase fw-bold">Status</small>
                        <div class="mt-1">
                            {% if job[2] == 'Completed' %}<span class="badge bg-success fs-6">Completed</span>
                            {% elif job[2] == 'In Progress' %}<span class="badge bg-primary fs-6">Active Now</span>
                            {% else %}<span class="badge bg-secondary fs-6">{{ job[2] }}</span>{% endif %}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted text-uppercase fw-bold">Location</small>
                        <div class="fw-bold mt-1">{{ job[6] }}</div>
                        <div class="small text-muted">{{ job[7] }}</div>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted text-uppercase fw-bold">Start Date</small>
                        <div class="fw-bold mt-1">
                            {{ job[4] or 'TBC' }}
                        </div>
                    </div>
                    {% if job[5] %}
                    <div class="col-md-6">
                        <small class="text-muted text-uppercase fw-bold">Completion Date</small>
                        <div class="fw-bold mt-1 text-success">
                            {{ job[5] }}
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mt-4">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="m-0 fw-bold"><i class="fas fa-camera me-2 text-brand"></i>Site Gallery</h5>
                <span class="badge bg-light text-dark border">{{ photos|length }} Photos</span>
            </div>
            <div class="card-body p-4">
                {% if photos %}
                    <div class="row g-3">
                        {% for p in photos %}
                        <div class="col-6 col-md-4 col-lg-3">
                            <div class="position-relative border rounded overflow-hidden shadow-sm group-hover-zoom" style="height: 180px;">
                                <a href="/{{ p[0] }}" target="_blank">
                                    <img src="/{{ p[0] }}" 
                                         class="w-100 h-100 object-fit-cover transition-transform" 
                                         style="transition: transform 0.3s ease;"
                                         alt="Site Photo"
                                         onmouseover="this.style.transform='scale(1.05)'"
                                         onmouseout="this.style.transform='scale(1)'"
                                         onerror="this.onerror=null;this.src='https://placehold.co/400x300?text=No+Image';">
                                </a>
                                
                                <div class="position-absolute bottom-0 start-0 w-100 p-2" 
                                     style="background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);">
                                    <small class="text-white d-block text-truncate">
                                        <i class="fas fa-calendar-alt me-1 opacity-75"></i> {{ p[1] }}
                                    </small>
                                    <span class="badge bg-white text-dark mt-1" style="font-size: 0.6rem; opacity: 0.9;">
                                        {{ p[2] or 'Site Photo' }}
                                    </span>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-5 text-muted bg-light rounded border border-dashed">
                        <i class="fas fa-images fa-3x mb-3 opacity-25"></i>
                        <p class="mb-0">No photos have been uploaded for this job yet.</p>
                        <small>Photos will appear here as our engineers upload them.</small>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 bg-brand text-white p-4" style="background-color: var(--brand-color);">
            <h5 class="fw-bold mb-3">Need Help?</h5>
            <p class="small opacity-75 mb-4">If you have questions about this ongoing work, please contact our office directly.</p>
            <a href="mailto:support@businessbetter.co.uk" class="btn btn-light fw-bold w-100">Contact Office</a>
        </div>
    </div>
</div>
{% endblock %}
</file>

<file path="templates/portal/portal_property_view.html">
{% extends "portal/portal_base.html" %}

{% block title %}Property | {{ company_name }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0">{{ prop[1] }}</h2>
        <p class="text-muted mb-0">{{ prop[2] }}</p>
    </div>
    <div class="d-flex gap-2">
        <form action="/portal/property/archive/{{ prop[0] }}" method="POST" onsubmit="return confirm('Archive this property? It will be hidden from your dashboard but history is kept.');">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}"> <button class="btn btn-outline-secondary btn-sm fw-bold">
			<button class="btn btn-outline-secondary btn-sm fw-bold">
                <i class="fas fa-archive me-1"></i> Archive
            </button>
        </form>
        <a href="/portal/home" class="btn btn-outline-secondary btn-sm fw-bold">
            <i class="fas fa-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

{% if compliance %}
<div class="row g-3 mb-4">
    {% for type, data in compliance.items() %}
    <div class="col-6 col-md-3">
        <div class="card h-100 border-0 shadow-sm border-start border-4 border-{{ data.class }}">
            <div class="card-body py-3">
                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">{{ type }}</small>
                <div class="d-flex justify-content-between align-items-end mt-1">
                    <h6 class="fw-bold m-0">{{ data.date }}</h6>
                    {% if data.download_url %}
                        <a href="{{ data.download_url }}" target="_blank" class="badge bg-{{ data.class }} text-white text-decoration-none" title="Download Certificate">
                            <i class="fas fa-download me-1"></i> {{ data.label }}
                        </a>
                    {% else %}
                        <span class="badge bg-{{ data.class }} text-white" style="font-size: 0.65rem;">{{ data.label }}</span>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white fw-bold py-3">
                <i class="fas fa-home me-2 text-brand"></i>Property Details
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Tenant Name</small>
                    <span class="fw-bold">{{ prop[4] or 'N/A' }}</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Tenant Phone</small>
                    <span class="fw-bold">{{ prop[5] or 'N/A' }}</span>
                </div>
                <div>
                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Access Code</small>
                    <span class="font-monospace bg-light px-2 rounded border">{{ prop[6] or 'Not Set' }}</span>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
             <div class="card-header bg-danger text-white fw-bold py-3">
                <i class="fas fa-exclamation-triangle me-2"></i>Report an Issue
            </div>
            <div class="card-body">
                <form action="/portal/request/submit" method="POST">
				<input type="hidden" name="csrf_token" value="{{ csrf_token() }}"> <input type="hidden" name="property_id" value="{{ prop[0] }}">
                    <input type="hidden" name="property_id" value="{{ prop[0] }}">
                    <div class="mb-3">
                        <label class="small fw-bold mb-1">Issue Description</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="Describe the fault..." required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="small fw-bold mb-1">Urgency</label>
                        <select name="severity" class="form-select">
                            <option value="Low">Low - Minor Repair</option>
                            <option value="Medium">Medium - Standard</option>
                            <option value="High">High - Urgent</option>
                        </select>
                    </div>
                    <button class="btn btn-danger w-100 fw-bold">Submit Request</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white fw-bold py-3">
                <i class="fas fa-history me-2 text-brand"></i>Job History
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light small text-uppercase text-muted">
                        <tr>
                            <th class="ps-4">Date</th>
                            <th>Reference</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for job in job_history %}
                        <tr>
                            <td class="ps-4 fw-bold">{{ job[4] }}</td>
                            <td>
                                <div class="fw-bold text-dark">{{ job[1] }}</div>
                                <small class="text-muted">{{ job[3] }}</small>
                            </td>
                            <td>
                                {% if job[2] == 'Completed' %} <span class="badge bg-success">Completed</span>
                                {% elif job[2] == 'In Progress' %} <span class="badge bg-primary">Active</span>
                                {% else %} <span class="badge bg-secondary">{{ job[2] }}</span> {% endif %}
                            </td>
                            <td class="text-end pe-4">
                                <a href="/portal/job/{{ job[0] }}" class="btn btn-sm btn-outline-secondary">View</a>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fas fa-clipboard-check fa-2x mb-3 opacity-25"></i>
                                <p class="mb-0">No history found.</p>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
</file>

<file path="templates/portal/portal_request_view.html">
{% extends "portal/portal_base.html" %}

{% block title %}Request #{{ req[0] }} | {{ company_name }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0">Request #{{ req[0] }}</h2>
        <span class="badge {{ 'bg-warning text-dark' if req[2] == 'Pending' else 'bg-success' }} mt-2">
            Status: {{ req[2] }}
        </span>
    </div>
    <a href="/portal/home" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-2"></i>Back
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <small class="text-muted d-block">Property</small>
                        <h6 class="fw-bold">{{ req[5] }} <span class="text-muted small fw-normal">({{ req[6] }})</span></h6>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <small class="text-muted d-block">Date Reported</small>
                        <h6 class="fw-bold">{{ req[3].strftime('%d %b %Y') }}</h6>
                    </div>
                    <div class="col-12 bg-light p-3 rounded mt-3">
                        <small class="text-muted d-block mb-1">Issue Description</small>
                        <p class="m-0 text-dark">{{ req[1] }}</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <h6 class="m-0 fw-bold"><i class="fas fa-history me-2 text-brand"></i>Activity Timeline</h6>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item p-4 border-start border-4 border-light">
                        <div class="d-flex justify-content-between">
                            <div>
                                <small class="text-uppercase fw-bold text-muted" style="font-size: 0.7rem;">Request Created</small>
                                <p class="mb-0 mt-1">Issue reported via Client Portal.</p>
                            </div>
                            <small class="text-muted">{{ req[3].strftime('%d %b %H:%M') }}</small>
                        </div>
                    </li>

                    {% if updates %}
                        {% for update in updates %}
                        <li class="list-group-item p-4 border-start border-4 border-info">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <small class="text-uppercase fw-bold text-primary" style="font-size: 0.7rem;">
                                        <i class="fas fa-headset me-1"></i> Update from {{ update[1] or 'Office' }}
                                    </small>
                                    <p class="mb-0 mt-1">{{ update[0] }}</p>
                                </div>
                                <small class="text-muted">{{ update[2].strftime('%d %b %H:%M') }}</small>
                            </div>
                        </li>
                        {% endfor %}
                    {% else %}
                        <li class="list-group-item p-4 text-center text-muted fst-italic">
                            No office updates yet. We are reviewing your request.
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
        {% if completion %}
        <div class="card shadow-sm border-0 border-top border-5 border-success">
            <div class="card-header bg-success text-white">
                <h5 class="m-0"><i class="fas fa-check-circle me-2"></i>Job Completion Report</h5>
            </div>
            <div class="card-body p-4">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <small class="text-muted">Completed By</small>
                        <h5 class="fw-bold">{{ completion[3] or 'Senior Engineer' }}</h5>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <small class="text-muted">Date Finished</small>
                        <h5 class="fw-bold">{{ completion[1].strftime('%d %b %Y') if completion[1] else 'Recently' }}</h5>
                    </div>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold">Engineer's Notes</h6>
                    <p>{{ completion[0] or 'Job completed successfully as requested.' }}</p>
                </div>

                {% if completion[2] %}
                <h6 class="fw-bold mb-3">Proof of Work (Photos)</h6>
                <div class="d-flex gap-3 overflow-auto pb-3">
                    <img src="{{ completion[2] }}" class="rounded shadow-sm" style="height: 150px; object-fit: cover;" alt="Job Photo">
                </div>
                {% endif %}
            </div>
        </div>
        {% elif req[2] == 'Completed' %}
        <div class="alert alert-success shadow-sm">
            <i class="fas fa-check me-2"></i> This issue has been marked as resolved by the office.
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
</file>

