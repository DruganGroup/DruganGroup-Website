    .btn-icon { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 6px; background: #333; color: #aaa; margin-left: 5px; transition: 0.2s; text-decoration: none; }
    .btn-icon:hover { color: #fff; background: #555; }
