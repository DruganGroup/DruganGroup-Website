                <span class="badge bg-success mb-3">{{ staff.status }}</span>
                
                <div class="d-flex justify-content-center gap-2 mb-4">
                    <a href="mailto:{{ staff.email }}" class="btn btn-sm btn-outline-dark"><i class="fas fa-envelope"></i> Email</a>
