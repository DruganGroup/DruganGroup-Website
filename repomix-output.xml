            border-color: var(--primary-gold);
            background: rgba(255,255,255,0.04);
        }
        .case-text { flex: 1; padding-right: 40px; }
        .case-visual { 
            flex: 0 0 420px; 
            background: #000; 
            border-radius: 12px; 
            padding: 20px; 
            font-family: 'Courier New', monospace; 
            font-size: 0.8rem; 
            color: #ccc;
            border: 1px solid #333;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        .case-tag {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: 700;
            margin-bottom: 15px;
            letter-spacing: 1px;
        }

