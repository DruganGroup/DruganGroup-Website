            justify-content: center;
            align-items: center;
        }
        
        /* Mobile Adjustment */
        @media(max-width: 900px) {
            .process-container::before { left: 20px; }
            .process-step, .process-step.reverse { flex-direction: column; padding-left: 50px; align-items: flex-start; }
            .step-icon-center { left: 20px; transform: translateX(-50%); }
            .step-content, .step-visual { width: 100%; margin-bottom: 20px; }
