<file path="templates/main_launcher.html">
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Business Better | Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body { 
            background-color: #1a1a1a; 
            color: white; 
            height: 100vh; 
            display: flex; 
            flex-direction: column; 
            font-family: 'Segoe UI', sans-serif; 
            margin: 0;
            overflow-x: hidden;
        }
        
        .launcher-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            width: 100%;
        }

        .header-bar {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto 40px auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        /* BRANDING */
        .brand-container { line-height: 1; }
        .brand-title { font-size: 2rem; font-weight: 800; margin: 0; letter-spacing: -0.5px; }
        .brand-sub { 
            color: #888; 
            font-size: 0.75rem; 
            text-transform: uppercase; 
            letter-spacing: 3px; 
            font-weight: 600; 
            margin-top: 5px;
            margin-left: 2px;
        }

        /* CARDS */
        .card-scroller { 
            display: flex; gap: 30px; justify-content: center; flex-wrap: wrap; padding: 20px;
        }

        .module-card {
            width: 280px; height: 350px; 
            border-radius: 20px;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            text-decoration: none;
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            cursor: pointer;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            position: relative;
            overflow: hidden;
            flex-shrink: 0;
        }
        
        .module-card:hover { transform: translateY(-10px) scale(1.02); filter: brightness(1.1); }
        .card-icon { font-size: 70px; margin-bottom: 25px; transition: 0.3s; }
        .module-card:hover .card-icon { transform: scale(1.1); }
        .card-title { font-size: 24px; font-weight: 800; margin-bottom: 5px; text-transform: uppercase; letter-spacing: 1px; }
        .card-sub { font-size: 14px; opacity: 0.8; font-weight: 500; }

        .site-card { background: linear-gradient(145deg, #E67E22, #d35400); color: white; }
        .office-card { background: linear-gradient(145deg, #3498DB, #2980b9); color: white; }
        .finance-card { background: linear-gradient(145deg, #27AE60, #219150); color: white; }
        .disabled { background: #333 !important; cursor: not-allowed; opacity: 0.5; filter: grayscale(1); pointer-events: none; }

        /* MODAL STYLING (Dark Theme Fixes) */
        .modal-content { background-color: #2c2c2c; color: white; border: 1px solid #444; }
        .modal-header { border-bottom: 1px solid #444; }
        .modal-footer { border-top: 1px solid #444; }
        
        /* Force Inputs to be readable */
        .form-control { 
            background-color: #333 !important; 
            border: 1px solid #555 !important; 
            color: white !important; 
        }
        .form-control:focus { 
            background-color: #444 !important; 
            color: white !important; 
            border-color: #3498DB !important; 
            box-shadow: none; 
        }
        
        /* Force Labels to be readable */
        .form-label { color: #ccc !important; font-size: 0.9rem; margin-bottom: 4px; }
        
        /* Tabs Styling */
        .nav-tabs { border-bottom: 1px solid #444; }
        .nav-tabs .nav-link { color: #aaa; border: none; }
        .nav-tabs .nav-link:hover { color: white; }
        .nav-tabs .nav-link.active { 
            background-color: #2c2c2c; 
            color: #3498DB; 
            border-bottom: 2px solid #3498DB; 
            font-weight: bold; 
        }

        @media (max-width: 768px) {
            .header-bar { flex-direction: column; align-items: flex-start; margin-top: 20px; }
            .card-scroller { justify-content: flex-start; flex-wrap: nowrap; overflow-x: auto; padding-bottom: 40px; width: 100%; scroll-snap-type: x mandatory; }
            .module-card { scroll-snap-align: center; width: 85vw; height: 60vh; margin-right: 15px; }
        }
    </style>
</head>
