						{{ s.name }} <i class="fas fa-external-link-alt ms-1 small opacity-50"></i></a><div class="small text-muted">{{ s.address or 'No address' }}</div>
						</td>
						<td>
							<span class="badge bg-secondary mb-1">{{ s.position or 'Staff' }}</span>
							<div class="small text-muted">{{ s.dept }}</div>
						</td>
						<td>
							{% if s.access_level and s.access_level != 'None' %}
								<span class="badge bg-success"><i class="fas fa-shield-alt me-1"></i> {{ s.access_level }}</span>
							{% else %}
								<span class="badge bg-light text-muted border">No Access</span>
							{% endif %}
						</td>
						<td>
                            {% if s.driving_license %}
                                <span class="text-success small"><i class="fas fa-check-circle"></i> On File</span>
                            {% else %}
                                <span class="text-muted small opacity-50"><i class="fas fa-times-circle"></i> Missing</span>
                            {% endif %}
                        </td>
						<td class="small">
							{% if s.email %}<div><i class="fas fa-envelope me-2 text-muted"></i>{{ s.email }}</div>{% endif %}
							{% if s.phone %}<div><i class="fas fa-phone me-2 text-muted"></i>{{ s.phone }}</div>{% endif %}
						</td>
						<td class="fw-bold text-success">£{{ s.pay_rate }}/{{ s.pay_model }}</td>
						<td class="text-end pe-4">
							<button class="btn btn-sm btn-outline-dark me-1" 
								data-bs-toggle="modal" data-bs-target="#staffModal"
								data-id="{{ s.id }}" data-name="{{ s.name }}" data-pos="{{ s.position }}"
								data-dept="{{ s.dept }}" data-email="{{ s.email }}" data-phone="{{ s.phone }}" 
								data-addr="{{ s.address }}" data-type="{{ s.employment_type }}" 
								data-rate="{{ s.pay_rate }}" data-model="{{ s.pay_model }}"
								data-tax="{{ s.tax_id }}" data-access="{{ s.access_level }}"
								onclick="fillEditStaff(this)">
								<i class="fas fa-edit"></i>
							</button>
							<a href="/hr/delete/{{ s.id }}" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure? This will remove the staff member and revoke their login access.');">
								<i class="fas fa-trash"></i>
							</a>
						</td>
					</tr>
					{% else %}
					<tr><td colspan="7" class="text-center py-5 text-muted">No staff found. Click "New Employee" to start.</td></tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

		<div class="modal fade" id="staffModal" tabindex="-1">
			<div class="modal-dialog modal-lg">
				<div class="modal-content">
                    <form method="POST" action="/hr/add" id="staffForm" enctype="multipart/form-data">
    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
						<div class="modal-header">
							<h5 class="modal-title fw-bold" id="modalTitle">New Employee Record</h5>
							<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
						</div>
						<div class="modal-body">
							<input type="hidden" name="staff_id" id="edit_id">
							
							<div class="row g-3">
								<div class="col-md-6"><label class="small fw-bold">Full Name</label><input type="text" name="name" id="edit_name" class="form-control" required></div>
								<div class="col-md-6"><label class="small fw-bold">Job Title</label><input type="text" name="position" id="edit_pos" class="form-control" placeholder="e.g. Site Manager"></div>
								
								<div class="col-md-6"><label class="small fw-bold">Email</label><input type="email" name="email" id="edit_email" class="form-control"></div>
								<div class="col-md-6"><label class="small fw-bold">Phone</label><input type="text" name="phone" id="edit_phone" class="form-control"></div>
								<div class="col-12"><label class="small fw-bold">Address</label><input type="text" name="address" id="edit_addr" class="form-control"></div>
								
                                <div class="col-12 mt-3 bg-warning bg-opacity-10 p-3 rounded border border-warning">
                                    <label class="fw-bold text-dark mb-2"><i class="fas fa-id-card me-2"></i>Driving License / ID Compliance</label>
                                    <input type="file" name="driving_license" class="form-control">
                                    <div class="form-text small">Upload a photo of the front of the driving license for insurance compliance.</div>
                                </div>
								<div class="col-12 mt-3 bg-primary bg-opacity-10 p-3 rounded border border-primary">
    <label class="fw-bold text-dark mb-2"><i class="fas fa-camera me-2"></i>Profile Photo</label>
    <input type="file" name="profile_photo" class="form-control" accept="image/*">
    <div class="form-text small">This photo will be displayed on their profile and ID cards.</div>
</div>
								
								<div class="col-12"><hr></div>
								
								<div class="col-md-4"><label class="small fw-bold">Employment Type</label>
									<select name="employment_type" id="edit_type" class="form-select">
										<option value="Full Time">Full Time (PAYE)</option>
										<option value="Part Time">Part Time (PAYE)</option>
										<option value="Sub-Contractor">Sub-Contractor (CIS)</option>
									</select>
								</div>
								<div class="col-md-4"><label class="small fw-bold">Dept</label>
									<select name="dept" id="edit_dept" class="form-select">
										<option value="Site">Site</option>
										<option value="Office">Office</option>
										<option value="Management">Management</option>
									</select>
								</div>
								
								<div class="col-md-2">
									<label class="small fw-bold">Rate (£)</label>
									<input type="number" step="0.01" name="pay_rate" id="edit_rate" class="form-control">
								</div>
								<div class="col-md-2">
									<label class="small fw-bold">Per</label>
									<select name="pay_model" id="edit_model" class="form-select">
										<option value="Hour">Hour</option>
										<option value="Day">Day</option>
										<option value="Year">Year</option>
									</select>
								</div>
								
								<div class="col-12 mt-4 p-3 bg-light rounded border border-secondary-subtle">
									<label class="fw-bold mb-2 text-dark"><i class="fas fa-lock me-2"></i>System Access</label>
									<div class="row align-items-center">
										<div class="col-md-6">
											<select name="access_level" id="edit_access" class="form-select border-dark fw-bold">
												<option value="None">No Access</option>
												<option value="Site">Site Dashboard</option>
												<option value="Office">Office Dashboard</option>
												<option value="Admin">Finance Dashboard</option>
											</select>
										</div>
										<div class="col-md-6">
											<div class="small text-muted lh-sm">
												<i class="fas fa-info-circle me-1"></i> 
												If granted, a <strong>secure password</strong> will be auto-emailed to the user immediately.
											</div>
										</div>
									</div>
								</div>

							</div>
						</div>
						<div class="modal-footer">
							<button type="submit" class="btn btn-primary fw-bold">Save Record</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	{% endblock %}

	{% block scripts %}
	<script>
		function resetAddStaff() {
			document.getElementById('staffForm').reset();
			// UPDATED ACTION
			document.getElementById('staffForm').action = "/hr/add";
			document.getElementById('edit_id').value = ""; 
			document.getElementById('modalTitle').innerText = "New Employee Record";
		}

		function fillEditStaff(btn) {
			// UPDATED ACTION
			document.getElementById('staffForm').action = "/hr/update";
			document.getElementById('modalTitle').innerText = "Edit Employee";
			
			document.getElementById('edit_id').value = btn.getAttribute('data-id');
			document.getElementById('edit_name').value = btn.getAttribute('data-name');
			document.getElementById('edit_pos').value = btn.getAttribute('data-pos');
			document.getElementById('edit_email').value = btn.getAttribute('data-email');
			document.getElementById('edit_phone').value = btn.getAttribute('data-phone');
			document.getElementById('edit_addr').value = btn.getAttribute('data-addr');
			document.getElementById('edit_type').value = btn.getAttribute('data-type');
			document.getElementById('edit_dept').value = btn.getAttribute('data-dept');
			document.getElementById('edit_rate').value = btn.getAttribute('data-rate');
			document.getElementById('edit_model').value = btn.getAttribute('data-model');
			
			let access = btn.getAttribute('data-access');
			document.getElementById('edit_access').value = (access && access !== 'None') ? access : 'None';
		}
	</script>
	{% endblock %}
</file>

<file path="templates/finance/finance_invoices.html">
{% extends "finance/finance_base.html" %}
{% from "components/_macros.html" import status_badge %}

{% block title %}Sales Ledger | Business Better{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0">Sales Ledger</h2>
            <p class="text-muted mb-0">Track all invoices and payments</p>
        </div>
        <div class="btn-group shadow-sm">
             <button class="btn btn-outline-dark fw-bold"><i class="fas fa-filter me-2"></i>Filter</button>
             <button class="btn btn-primary fw-bold"><i class="fas fa-plus me-2"></i>New Invoice</button>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between">
            <h5 class="fw-bold m-0 text-secondary">All Invoices</h5>
            <span class="badge bg-light text-dark border">{{ invoices|length }} Records</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase small">
                    <tr>
                        <th class="ps-4">Invoice #</th>
                        <th>Client</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Total</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for inv in invoices %}
                    <tr>
                        <td class="ps-4 fw-bold text-primary">{{ inv.ref }}</td>
                        <td>{{ inv.client }}</td>
                        <td class="small">{{ inv.date }}</td>
                        <td>{{ status_badge(inv.status) }}</td>
                        <td class="text-end pe-4 fw-bold">{{ currency }}{{ "%.2f"|format(inv.total or 0) }}</td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <button class="btn btn-sm btn-light border" 
                                        title="Quick View"
                                        onclick="openInvoiceDrawer('{{ inv.ref }}', '{{ inv.client }}', '{{ '%.2f'|format(inv.total or 0) }}', '{{ inv.status }}')">
                                    <i class="fas fa-eye text-dark"></i>
                                </button>
                                
                                <button type="button" class="btn btn-sm btn-light border dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown"></button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                    <li><h6 class="dropdown-header small text-uppercase">Manage</h6></li>
                                    <li>
                                        <a class="dropdown-item" href="{{ url_for('pdf.download_invoice_pdf', invoice_id=inv.id) }}" target="_blank">
                                            <i class="fas fa-file-pdf me-2 text-danger"></i>Download PDF
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="{{ url_for('finance.email_invoice', invoice_id=inv.id) }}" 
                                           onclick="return confirm('Email this invoice to the client?');">
                                            <i class="fas fa-envelope me-2 text-primary"></i>Email Client
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" href="{{ url_for('finance.mark_invoice_sent', invoice_id=inv.id) }}">
                                            <i class="fas fa-check me-2 text-success"></i>Mark Sent
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="{{ url_for('finance.delete_invoice', invoice_id=inv.id) }}"
                                           onclick="return confirm('⚠️ Are you sure? This will permanently delete this invoice.');">
                                            <i class="fas fa-trash me-2"></i>Delete
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="6" class="text-center py-5 text-muted">No invoices found. Generate one from a Quote.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="invoiceDrawer" style="width: 500px;">
        <div class="offcanvas-header bg-light border-bottom">
            <h5 class="offcanvas-title fw-bold" id="drawerTitle">Invoice Details</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>
        
        <div class="offcanvas-body" id="drawerContent">
            <div class="text-center mt-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted">Loading...</p>
            </div>
        </div>

        <div class="offcanvas-footer p-3 border-top bg-light">
            <button class="btn btn-primary w-100 fw-bold">
                <i class="fas fa-download me-2"></i> Download PDF
            </button>
        </div>
    </div>
{% endblock %}

{% block scripts %}
<script>
    function openInvoiceDrawer(ref, client, total, status) {
        // Find the drawer element
        var myDrawer = new bootstrap.Offcanvas(document.getElementById('invoiceDrawer'));
        
        // Update the Title
        document.getElementById('drawerTitle').innerText = "Invoice #" + ref;
        
        // Fill the content box with data
        var content = `
            <div class="p-3 bg-light rounded border mb-3">
                <div class="small text-muted text-uppercase fw-bold">Client</div>
                <div class="fs-5 fw-bold">${client}</div>
            </div>
            
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <div class="p-3 border rounded text-center">
                        <div class="small text-muted">Total</div>
                        <div class="fw-bold text-success fs-5">£${total}</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 border rounded text-center">
                        <div class="small text-muted">Status</div>
                        <div class="fw-bold">${status}</div>
                    </div>
                </div>
            </div>

            <div class="alert alert-info small">
                <i class="fas fa-info-circle me-2"></i> 
                This is a quick preview. Download the PDF for the full legal document.
            </div>
        `;
        
        // Inject and Show
        document.getElementById('drawerContent').innerHTML = content;
        myDrawer.show();
    }
</script>
{% endblock %}
</file>

<file path="templates/finance/finance_materials.html">
{% extends "finance/finance_base.html" %}

{% block title %}Material Library | Business Better{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0">Materials & Suppliers</h2>
            <p class="text-muted mb-0">Manage price lists (Travis Perkins, Jewson, etc.)</p>
        </div>
        
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary fw-bold" data-bs-toggle="modal" data-bs-target="#addSupplierModal">
                <i class="fas fa-truck me-2"></i>Add Supplier
            </button>
            <button class="btn btn-dark fw-bold" data-bs-toggle="modal" data-bs-target="#importModal">
                <i class="fas fa-file-csv me-2"></i>Upload Price List
            </button>
        </div>
    </div>

    <div class="d-flex gap-2 mb-3 overflow-auto">
        <span class="badge bg-dark p-2 d-flex align-items-center">All Items</span>
        {% for s in suppliers %}
        <span class="badge bg-white text-dark border p-2 d-flex align-items-center gap-2">
            {{ s.name }}
            <a href="/finance/suppliers/delete/{{ s.id }}" 
               class="text-danger text-decoration-none fw-bold"
               onclick="return confirm('Delete {{ s.name }}? Any linked materials will become General items.')">
               &times;
            </a>
        </span>
        {% endfor %}
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white p-3 border-bottom">
            <input type="text" id="searchInput" onkeyup="filterTable()" class="form-control" placeholder="Type to search database...">
        </div>
        <div class="table-responsive" style="max-height: 70vh;">
            <table class="table table-hover align-middle mb-0" id="materialTable">
                <thead class="table-light small text-uppercase sticky-top">
                    <tr>
                        <th class="ps-4">Supplier</th>
                        <th>SKU</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th class="text-end pe-4">Cost Price</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for m in materials %}
                    <tr>
                        <td class="ps-4"><span class="badge bg-secondary bg-opacity-10 text-dark">{{ m.supplier }}</span></td>
                        <td class="small font-monospace text-muted">{{ m.sku }}</td>
                        <td class="fw-bold">{{ m.name }}</td>
                        <td>{{ m.category }}</td>
                        <td class="text-end pe-4">£{{ "%.2f"|format(m.price) }}</td>
                        <td class="text-end">
                            <a href="/finance/materials/delete/{{ m.id }}" class="text-danger"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="6" class="text-center py-5 text-muted">No materials. Add a Supplier then Upload a CSV.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="addSupplierModal" tabindex="-1">
        <div class="modal-dialog">
            <form action="/finance/suppliers/add" method="POST" class="modal-content">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Supplier</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="small fw-bold text-muted">Supplier Name</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Travis Perkins" required>
                    </div>
                    
                    <div class="mb-3">
                        <label class="small fw-bold text-muted">Ordering Email Address</label>
                        <input type="email" name="email" class="form-control" placeholder="orders@supplier.com">
                        <div class="form-text small">This is where material lists will be emailed.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary fw-bold">Create Supplier</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="importModal" tabindex="-1">
        <div class="modal-dialog">
            <form action="/finance/materials/import" method="POST" enctype="multipart/form-data" class="modal-content">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Import Price List</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info small">
                        CSV Format: <strong>SKU, Name, Category, Unit, Cost Price</strong>
                    </div>
                    
                    <div class="mb-3">
                        <label class="small fw-bold text-muted">Select Supplier</label>
                        <select name="supplier_id" class="form-select" required>
                            <option value="" disabled selected>-- Choose --</option>
                            {% for s in suppliers %}
                            <option value="{{ s.id }}">{{ s.name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <label class="small fw-bold text-muted">CSV File</label>
                    <input type="file" name="file" class="form-control" required accept=".csv">
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-dark fw-bold w-100">Upload & Process</button>
                </div>
            </form>
        </div>
    </div>
    
    <script>
    function filterTable() {
        var input = document.getElementById("searchInput");
        var filter = input.value.toUpperCase();
        var table = document.getElementById("materialTable");
        var tr = table.getElementsByTagName("tr");
        for (var i = 1; i < tr.length; i++) {
            var td = tr[i].getElementsByTagName("td")[2]; // Search Name
            if (td) {
                var txtValue = td.textContent || td.innerText;
                if (txtValue.toUpperCase().indexOf(filter) > -1) { tr[i].style.display = ""; } else { tr[i].style.display = "none"; }
            }       
        }
    }
    </script>
{% endblock %}
</file>

<file path="templates/finance/finance_payroll.html">
{% extends "finance/finance_base.html" %}

{% block title %}Payroll | Business Better{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0">Payroll Run</h2>
        <p class="text-muted mb-0">
            Week Commencing: <span class="text-dark fw-bold">{{ week_start.strftime('%d %b') }}</span> 
            to <span class="text-dark fw-bold">{{ week_end.strftime('%d %b %Y') }}</span>
        </p>
    </div>
    
    <div class="d-flex gap-2">
        <button class="btn btn-outline-dark fw-bold" onclick="window.print()">
            <i class="fas fa-print me-2"></i> Print Report
        </button>
        <button class="btn btn-success fw-bold shadow-sm">
            <i class="fas fa-lock me-2"></i> Finalize & Pay
        </button>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 bg-light">
            <h6 class="text-muted text-uppercase small fw-bold">Total Gross Pay</h6>
            <h2 class="fw-bold text-dark m-0">{{ currency }}{{ "%.2f"|format(totals.gross) }}</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 bg-danger bg-opacity-10">
            <h6 class="text-danger text-uppercase small fw-bold">Total Taxes & Deductions</h6>
            <h2 class="fw-bold text-danger m-0">- {{ currency }}{{ "%.2f"|format(totals.tax) }}</h2>
            <small class="text-danger opacity-75">
                {% if settings.get('country_code') == 'UK' %}PAYE / NI{% elif settings.get('country_code') == 'US' %}Fed / FICA{% else %}Tax / Social{% endif %}
            </small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 bg-success bg-opacity-10">
            <h6 class="text-success text-uppercase small fw-bold">Net Payable</h6>
            <h2 class="fw-bold text-success m-0">{{ currency }}{{ "%.2f"|format(totals.net) }}</h2>
            <small class="text-success opacity-75">Transfer Amount</small>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark small text-uppercase">
                <tr>
                    <th class="ps-4">Employee</th>
                    <th>Status</th>
                    <th>Hours</th>
                    <th class="text-end text-light">Gross Pay</th>
                    <th class="text-end text-danger">Tax</th>
                    <th class="text-end text-danger">
                        {% if settings.get('country_code') == 'UK' %}NI{% elif settings.get('country_code') == 'US' %}FICA{% else %}Social{% endif %}
                    </th>
                    <th class="text-end pe-4 text-success">Net Pay</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for p in payroll %}
                <tr>
                    <td class="ps-4">
                        <div class="fw-bold text-dark">{{ p.name }}</div>
                        <div class="small text-muted">{{ p.role }}</div>
                    </td>
                    <td>
                        {% if p.type == 'Sub-Contractor' %}
                            <span class="badge bg-warning text-dark border">Contractor</span>
                        {% else %}
                            <span class="badge bg-info text-dark border">PAYE</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="fw-bold">{{ p.hours }} hrs</div>
                        <div class="small text-muted">({{ p.days }} days)</div>
                    </td>
                    <td class="text-end fw-bold text-dark bg-light border-start">
                        {{ currency }}{{ "%.2f"|format(p.gross) }}
                    </td>
                    <td class="text-end text-danger small">
                        {% if p.tax > 0 %}- {{ currency }}{{ "%.2f"|format(p.tax) }}{% else %}-{% endif %}
                    </td>
                    <td class="text-end text-danger small border-end">
                        {% if p.social > 0 %}- {{ currency }}{{ "%.2f"|format(p.social) }}{% else %}-{% endif %}
                    </td>
                    <td class="text-end pe-4 fw-bold text-success bg-success bg-opacity-10">
                        {{ currency }}{{ "%.2f"|format(p.net) }}
                    </td>
                    <td class="text-end">
                        <a href="/hr/staff/{{ p.id }}" class="btn btn-sm btn-outline-secondary" title="View Profile">
                            <i class="fas fa-eye"></i>
                        </a>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="8" class="text-center py-5 text-muted">No active staff records found for this week.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4 p-3 bg-light border rounded small text-muted">
    <i class="fas fa-info-circle me-2"></i> 
    <strong>Note:</strong> Tax calculations are estimates based on standard national brackets for <strong>{{ settings.get('country_code', 'UK') }}</strong>. 
    Actual payroll submissions should be verified with your accountant or official payroll software.
</div>
{% endblock %}
</file>

<file path="templates/finance/settings_banking.html">
