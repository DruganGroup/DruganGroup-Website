<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Currency/Country Auto-select logic
        const countrySelect = document.querySelector('select[name="country_code"]');
        const currencySelect = document.querySelector('select[name="currency_symbol"]');
        const countryToCurrency = { 'UK': '£', 'US': '$', 'IE': '€', 'CAN': '$', 'AUS': '$', 'NZ': '$' };

        if(countrySelect && currencySelect) {
            countrySelect.addEventListener('change', function() {
                const currency = countryToCurrency[this.value];
                if(currency) {
                    for(let i=0; i < currencySelect.options.length; i++) {
                        if(currencySelect.options[i].value === currency) {
                            currencySelect.selectedIndex = i; break;
                        }
                    }
                }
            });
        }
    });
</script>
