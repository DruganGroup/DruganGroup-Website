<file path="templates/admin/system_logs.html">
{% extends "admin/base.html" %}

{% block title %}System Logs | Business Better{% endblock %}

{% block styles %}
<style>
    .table-dark-custom th { color: var(--primary-gold) !important; border-color: #444 !important; }
    .log-trace { background: #000; color: #ff3333; padding: 15px; font-family: monospace; font-size: 0.75rem; border-left: 3px solid #ff3333; margin: 10px 0; white-space: pre-wrap; }
    .user-pill { background: #222; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; color: #fff; border: 1px solid #444; }
    .btn-page { border: 1px solid var(--primary-gold); color: var(--primary-gold); padding: 5px 10px; margin: 0 2px; text-decoration: none; border-radius: 4px; }
    .btn-page:hover { background: var(--primary-gold); color: black; }
</style>
{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-end mb-4">
    <h2 class="fw-bold text-white">System <span class="text-gold">Logs</span></h2>
</div>

<div class="card-dark shadow-lg">
    <table class="table table-dark-custom table-hover mb-0">
        <thead>
            <tr>
                <th>Time</th>
                <th>Status</th>
                <th>Route</th>
                <th>User / Company</th>
                <th>Message</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for log in logs %}
            <tr>
                <td class="small text-muted" style="white-space:nowrap;">{{ log[1] }}</td>
                <td>
                    {% if log[9] >= 500 %}<span class="badge bg-danger">{{ log[9] }}</span>
                    {% elif log[9] >= 400 %}<span class="badge bg-warning text-dark">{{ log[9] }}</span>
                    {% else %}<span class="badge bg-secondary">{{ log[9] }}</span>{% endif %}
                </td>
                <td><code class="text-gold">{{ log[5] }}</code></td>
                <td>
                    {% if log[7] %}<div class="user-pill mb-1"><i class="fas fa-user me-1"></i> {{ log[7] }}</div>{% endif %}
                    {% if log[8] %}<div class="small text-muted">{{ log[8] }}</div>{% endif %}
                    <div class="small text-muted" style="font-size:0.7rem;">{{ log[6] }}</div> </td>
                <td style="max-width:300px; word-wrap:break-word;">{{ log[3] }}</td>
                <td><button class="btn btn-sm btn-outline-secondary" onclick="toggleTrace({{ log[0] }})">View Trace</button></td>
            </tr>
            <tr id="trace-{{ log[0] }}" style="display:none; background:#0a0a0a;"><td colspan="6"><div class="log-trace">{{ log[4] }}</div></td></tr>
            {% else %}
            <tr><td colspan="6" class="text-center p-5 text-success">✅ System is healthy.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    
    {% if total_pages > 1 %}
    <div class="d-flex justify-content-center p-3">
        {% for p in range(1, total_pages + 1) %}
        <a href="{{ url_for('admin.view_system_logs', page=p) }}" class="btn-page">{{ p }}</a>
        {% endfor %}
    </div>
    {% endif %}
</div>

<!-- ── DANGER ZONE ── -->
<div class="card-dark shadow-lg mt-4" style="border: 1px solid #ff3333;">
    <div class="p-3 d-flex align-items-center" style="border-bottom: 1px solid #ff3333;">
        <i class="fas fa-exclamation-triangle text-danger me-2"></i>
        <h6 class="fw-bold text-danger mb-0">Log Maintenance — Danger Zone</h6>
        <span class="ms-auto small text-muted">Total logs: <strong class="text-white">{{ total_logs }}</strong></span>
    </div>
    <div class="p-3 d-flex flex-wrap gap-3 align-items-end">

        <!-- DELETE OLDER THAN -->
        <form method="POST" action="{{ url_for('admin.delete_system_logs') }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="mode" value="older_than">
            <label class="small text-muted d-block mb-1">Delete logs older than:</label>
            <div class="d-flex gap-2 align-items-center">
                <select name="days" class="form-select form-select-sm" style="background:#1a1a1a; color:#fff; border-color:#444; width:120px;">
                    <option value="30">30 days</option>
                    <option value="60">60 days</option>
                    <option value="90" selected>90 days</option>
                    <option value="180">180 days</option>
                </select>
                <button type="submit" class="btn btn-sm btn-outline-warning"
                        onclick="return confirm('Delete all system logs older than the selected age?')">
                    <i class="fas fa-trash-alt me-1"></i> Delete Old Logs
                </button>
            </div>
        </form>

        <!-- WIPE ALL -->
        <div>
            <label class="small text-muted d-block mb-1">Nuclear option:</label>
            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#wipeLogsModal">
                <i class="fas fa-radiation me-1"></i> Wipe ALL Logs
            </button>
        </div>

    </div>
</div>

<!-- ── WIPE ALL CONFIRMATION MODAL ── -->
<div class="modal fade" id="wipeLogsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:#1a1a1a; border:1px solid #ff3333;">
            <div class="modal-header" style="border-color:#ff3333;">
                <h5 class="modal-title text-danger"><i class="fas fa-radiation me-2"></i>Wipe ALL System Logs</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-white">You are about to <strong class="text-danger">permanently delete every system log entry</strong> in the database.</p>
                <p class="text-muted small mb-3">This action is irreversible. This deletion will itself be recorded in the Audit Log.</p>
                <label class="small text-muted">Type <strong class="text-white">WIPE</strong> to confirm:</label>
                <input type="text" id="wipeConfirmInput" class="form-control mt-1" style="background:#111; color:#fff; border-color:#555;" placeholder="WIPE">
            </div>
            <div class="modal-footer" style="border-color:#333;">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="POST" action="{{ url_for('admin.delete_system_logs') }}" id="wipeAllForm">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                    <input type="hidden" name="mode" value="all">
                    <button type="submit" id="wipeConfirmBtn" class="btn btn-danger" disabled>
                        <i class="fas fa-radiation me-1"></i> Confirm Wipe
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
function toggleTrace(id) {
    var x = document.getElementById('trace-' + id);
    x.style.display = (x.style.display === "none") ? "table-row" : "none";
}

// Enable wipe button only when user types WIPE
document.getElementById('wipeConfirmInput').addEventListener('input', function() {
    document.getElementById('wipeConfirmBtn').disabled = (this.value.trim() !== 'WIPE');
});
</script>
{% endblock %}
</file>

