                {% endif %}
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-danger">
            <div class="card-header bg-white fw-bold text-danger">
                <i class="fas fa-heartbeat me-2"></i> Emergency Contact
            </div>
            <div class="card-body">
                {% if staff.nok_name %}
                    <h6 class="fw-bold mb-1">{{ staff.nok_name }}</h6>
                    <p class="text-muted small mb-3">{{ staff.nok_relationship }}</p>
                    
                    <a href="tel:{{ staff.nok_phone }}" class="btn btn-danger btn-sm w-100 fw-bold mb-2">
                        <i class="fas fa-phone-alt me-2"></i> {{ staff.nok_phone }}
                    </a>
                    
                    {% if staff.nok_address %}
                    <hr class="my-2">
                    <div class="small text-muted">
                        <i class="fas fa-map-marker-alt me-1"></i> {{ staff.nok_address }}
                    </div>
                    {% endif %}
                {% else %}
                    <div class="text-center text-muted py-3 small">
                        <i class="fas fa-exclamation-circle mb-2"></i><br>
                        No Next of Kin details recorded.<br>
                        <a href="#" data-bs-toggle="modal" data-bs-target="#editProfileModal">Add Details</a>
                    </div>
                {% endif %}
            </div>
        </div>

    </div> 

    <div class="col-md-8">
        
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                <div><i class="fas fa-clock me-2 text-warning"></i> Wages & Timesheets</div>
                <span class="badge bg-success">Rate: {{ currency }}{{ staff.pay_rate }}/{{ staff.pay_model }}</span>
            </div>
            
            <div class="accordion accordion-flush" id="wageAccordion">
                {% for week in weeks %}
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#week{{ loop.index }}">
                            <div class="d-flex justify-content-between w-100 me-3">
                                <span class="fw-bold">Week #{{ week.week_num }}</span>
                                <div class="text-end">
                                    <span class="badge bg-light text-dark border me-2">{{ week.total_hours|round(2) }} Hrs</span>
                                    <span class="badge bg-success">{{ currency }}{{ week.total_cost|round(2) }}</span>
                                </div>
                            </div>
                        </button>
                    </h2>
                    <div id="week{{ loop.index }}" class="accordion-collapse collapse" data-bs-parent="#wageAccordion">
                        <div class="accordion-body p-0">
                            <table class="table table-sm table-striped mb-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Day</th>
                                        <th>Activity / Job</th>
                                        <th class="text-center">Hrs</th>
                                        <th class="text-end pe-3">Cost</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for day in week.days %}
                                    <tr>
                                        <td class="ps-3" style="width: 20%;">
                                            <div class="fw-bold">{{ day.date }}</div>
                                            <span class="text-muted" style="font-size: 0.75rem;">{{ day.clock_in }} - {{ day.clock_out }}</span>
                                        </td>
                                        <td>
                                            {% if day.linked_jobs %}
                                                {% for j in day.linked_jobs %}
                                                    <a href="/office/job/{{ j.id }}/files" class="badge bg-primary text-decoration-none mb-1">
                                                        <i class="fas fa-hard-hat me-1"></i> {{ j.ref }}
                                                    </a>
                                                    <div class="text-truncate text-muted" style="font-size: 0.75rem; max-width: 150px;">{{ j.site }}</div>
                                                {% endfor %}
                                            {% else %}
                                                <span class="text-muted fst-italic">No specific job linked</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-center">{{ day.hours|round(2) }}</td>
                                        <td class="text-end pe-3 fw-bold">{{ currency }}{{ day.cost }}</td>
                                    </tr>
                                    {% endfor %}
                                    <tr class="table-secondary fw-bold">
                                        <td colspan="2" class="ps-3">WEEKLY TOTAL</td>
                                        <td class="text-center">{{ week.total_hours|round(2) }}</td>
                                        <td class="text-end pe-3">{{ currency }}{{ week.total_cost|round(2) }}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                {% else %}
                <div class="p-4 text-center text-muted">No timesheets recorded yet.</div>
                {% endfor %}
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white fw-bold">
                <i class="fas fa-briefcase me-2 text-primary"></i> Job History
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Job Ref</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th class="text-end pe-3">Site</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for j in jobs %}
                        <tr>
                            <td class="ps-3 fw-bold">{{ j.title }}</td>
                            <td>
                                <span class="badge {{ 'bg-success' if j.status == 'Completed' else 'bg-primary' }}">
                                    {{ j.status }}
                                </span>
                            </td>
                            <td>{{ j.start_date }}</td>
                            <td class="text-end pe-3 text-truncate" style="max-width: 150px;">{{ j.site_address }}</td>
                        </tr>
                        {% else %}
                        <tr><td colspan="4" class="text-center text-muted py-3">No jobs assigned recently.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white fw-bold">
                <i class="fas fa-check-double me-2 text-info"></i> Vehicle Checks
            </div>
            <div class="list-group list-group-flush small">
                {% for c in checks %}
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold">{{ c.reg_number }}</span>
                        <span class="text-muted ms-2">{{ c.date }}</span>
                        <div class="text-muted">{{ c.notes }}</div>
                    </div>
                    {% if c.passed %}
                        <span class="badge bg-success">PASS</span>
                    {% else %}
                        <span class="badge bg-danger">FAIL</span>
                    {% endif %}
                </div>
                {% else %}
                <div class="text-center text-muted py-3">No vehicle checks recorded.</div>
                {% endfor %}
            </div>
        </div>

    </div> 
</div>

<div class="modal fade" id="editProfileModal" tabindex="-1">
