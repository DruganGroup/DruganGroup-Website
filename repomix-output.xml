                            <li class="mb-3"><i class="fas fa-user {{ 'text-gold' if is_popular else 'text-secondary' }} me-2"></i> 
                                <strong>{{ plan.max_users if plan.max_users > 0 else 'Unlimited' }}</strong> Staff
                            </li>
                            
                            {% if plan.max_vehicles > 0 %}
                            <li class="mb-3"><i class="fas fa-truck {{ 'text-gold' if is_popular else 'text-secondary' }} me-2"></i> 
                                <strong>{{ plan.max_vehicles }}</strong> Vehicles
                            </li>
                            {% endif %}

                            {% if 'Finance' in plan.modules %}
                            <li class="mb-3"><i class="fas fa-check text-gold me-2"></i> Quotes & Invoices</li>
                            {% endif %}
                            
                            {% if 'Portal' in plan.modules %}
                            <li class="mb-3"><i class="fas fa-check text-gold me-2"></i> Client Portal</li>
                            {% endif %}

                            {% if 'Fleet' in plan.modules %}
                            <li class="mb-3"><i class="fas fa-check text-gold me-2"></i> Vehicle Checks (MOT)</li>
                            {% endif %}

                            {% if 'Compliance' in plan.modules %}
                            <li class="mb-3"><i class="fas fa-check text-gold me-2"></i> CP12/EICR Certs</li>
                            {% endif %}
                            
                            {% if 'RAMS' in plan.modules %}
                            <li class="mb-3"><i class="fas fa-check text-gold me-2"></i> <strong>RAMS Studio</strong></li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </div>
            
            {% endif %}
            {% else %}
            <div class="col-12 text-center text-muted">
                <i class="fas fa-info-circle me-2"></i> No plans configured yet.
            </div>
            {% endfor %}

        </div>

        <div class="row justify-content-center mt-5">
            
            {% for plan in plans %}
            {% if 'Agency' in plan.name %}
            
            <div class="col-lg-8 mb-4">
                <div class="card border-info bg-black text-white rounded-4 position-relative overflow-hidden">
                    <div class="row g-0 align-items-center">
                        <div class="col-md-5 p-4 bg-dark border-end border-secondary text-center d-flex flex-column justify-content-center h-100">
                            <h4 class="fw-bold text-info mb-2">{{ plan.name }}</h4>
                            <div class="display-5 fw-bold text-white mb-2">£{{ "%.0f"|format(plan.price) }}<span class="fs-6 text-secondary fw-normal">/mo</span></div>
                            <small class="text-secondary">For Estate Agents & Block Managers</small>
                        </div>
                        <div class="col-md-7 p-4">
                            <p class="text-secondary mb-3">
                                Connect your tenants directly to your maintenance desk.
                            </p>
                            <div class="row g-2 mb-4">
                                <div class="col-6"><small class="text-white"><i class="fas fa-check text-info me-2"></i> <strong>{{ plan.max_properties if plan.max_properties > 0 else 'Unlimited' }}</strong> Properties</small></div>
                                <div class="col-6"><small class="text-white"><i class="fas fa-check text-info me-2"></i> Tenant Reporting</small></div>
                                
                                {% if 'Compliance' in plan.modules %}
                                <div class="col-6"><small class="text-white"><i class="fas fa-check text-info me-2"></i> Compliance Tracking</small></div>
                                {% endif %}
                                
                                <div class="col-6"><small class="text-white"><i class="fas fa-check text-info me-2"></i> Auto-Dispatch Logic</small></div>
                            </div>
                            <a href="/register?plan={{ plan.id }}" class="btn btn-outline-info rounded-pill w-100">Start {{ plan.name }} Trial</a>
                        </div>
                    </div>
                </div>
            </div>

            {% endif %}
            {% endfor %}
            
        </div>

    </div>
</section>

<style>
    .hover-lift { transition: transform 0.3s ease, border-color 0.3s ease; }
    .hover-lift:hover { transform: translateY(-5px); border-color: var(--bb-gold) !important; }
    
    .transform-scale { transform: scale(1.05); z-index: 2; }
    @media (max-width: 992px) { .transform-scale { transform: scale(1); } }
</style>
