    .stat-number {
        font-family: 'Playfair Display', serif;
        font-size: 3rem;
        color: var(--bb-gold);
        line-height: 1;
        margin-bottom: 10px;
    }

    /* Hero Glow */
    .hero-glow {
        position: absolute;
        top: -20%;
        left: 50%;
        transform: translateX(-50%);
        width: 800px;
        height: 800px;
        background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, rgba(0,0,0,0) 70%);
        z-index: 0;
        pointer-events: none;
    }
</style>
{% endblock %}

{% block content %}

