                                    <div class="col-md-5">
                                        <label class="form-label">Relationship</label>
                                        <input type="text" name="nok_relationship" class="form-control" value="{{ my_profile.nok_relationship or '' }}" placeholder="e.g. Wife, Mother">
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Emergency Phone</label>
                                        <input type="text" name="nok_phone" class="form-control" value="{{ my_profile.nok_phone or '' }}" placeholder="Emergency number">
