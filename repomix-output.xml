                <div class="card h-100 {{ 'border-warning shadow-lg bg-black transform-scale' if is_popular else 'border-secondary bg-dark hover-lift' }} text-white rounded-4 position-relative">
                    
                    {% if is_popular %}
                    <div class="position-absolute top-0 start-50 translate-middle badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm">
                        MOST POPULAR
                    </div>
                    {% endif %}

                    <div class="card-body p-5 text-center">
                        <h4 class="fw-bold {{ 'text-gold' if is_popular else 'text-secondary' }} mb-3">{{ plan.name }}</h4>
                        <div class="display-4 fw-bold mb-3 text-white">£{{ "%.0f"|format(plan.price) }}<span class="fs-6 text-secondary fw-normal">/mo</span></div>
                        
                        <p class="text-secondary small mb-4">
                            {% if plan.price < 50 %}Perfect for getting organized.
                            {% elif plan.price < 150 %}Connect the office to the van.
                            {% else %}Total control for larger firms.{% endif %}
                        </p>
                        
                        <div class="d-grid mb-4">
                            <a href="/register?plan={{ plan.id }}" class="btn {{ 'btn-brand fw-bold' if is_popular else 'btn-outline-light' }} rounded-pill">Start Free Trial</a>
