        .sector-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-top: 40px; }
        .sector-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); padding: 30px; border-radius: 12px; transition: 0.3s; }
        .sector-card:hover { background: rgba(255,255,255,0.06); border-color: var(--primary-gold); transform: translateY(-5px); }
        .sector-card h4 { color: #fff; margin-bottom: 10px; font-size: 1.1rem; }
        .sector-card p { font-size: 0.9rem; color: #aaa; }
        .sector-icon { font-size: 2rem; color: var(--primary-gold); margin-bottom: 20px; }

